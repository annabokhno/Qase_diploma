<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Qase suite">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="UI 1">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
